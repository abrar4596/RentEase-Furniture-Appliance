# ==============================================================================
# RentEase Monorepo Environment Variables Template
# Copy this file to .env in local development
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# --- Node Environment ---
# Allowed: development | production | test (default: development)
NODE_ENV=development
# API server port (default: 5000; Render injects PORT automatically)
PORT=5000

# --- Web Frontend (@rentease/web) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# --- MongoDB Database (Required in production) ---
MONGODB_URI=mongodb://localhost:27017/rentease_dev

# --- CORS & Client Allowlist (Required in production) ---
# Must be a valid single origin URL (e.g., https://your-app.vercel.app) with no trailing slash
CORS_ORIGIN=http://localhost:3000

# --- Authentication & JWT (Required in production) ---
# Production rule: MUST be >= 32 characters and MUST NOT start with "dev_"
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_jwt_access_secret_min_32_characters_random_string!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_min_32_characters_random_string!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Production rule: MUST be >= 32 characters and MUST NOT start with "dev_"
COOKIE_SECRET=dev_cookie_secret_at_least_32_chars_long!!

# --- Google OAuth (Required in production) ---
GOOGLE_CLIENT_ID=

# --- Cloudinary (Required in production) ---
# Production rule: non-empty, must not contain "placeholder", and must not equal "rentease_test_cloud" / test defaults
CLOUDINARY_CLOUD_NAME=rentease_test_cloud
CLOUDINARY_API_KEY=test_api_key_123456789
CLOUDINARY_API_SECRET=test_api_secret_abcdefghijk

# --- Razorpay (Required in production) ---
# Production rule: non-empty and must not contain "placeholder"
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_key

# --- Rate Limiting & Platform Rules (Optional, defaults shown) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PLATFORM_COMMISSION_PERCENT=15
KYC_WINDOW_HOURS=24
RESERVATION_TTL_MINUTES=15

# --- Optional Seed Scripts (apps/api/src/scripts/seed*.ts) ---
DEMO_SEED=false
DEMO_PASSWORD=
ADMIN_EMAIL=admin@rentease.in
ADMIN_PASSWORD=RentEase@Admin2026
ADMIN_NAME=Platform Admin
